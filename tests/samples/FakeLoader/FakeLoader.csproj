<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Benign test fixture shaped like a .NET malware loader (see tests/samples/README.md).
    build.ps1 generates payload.bin from Stage2 before building this project.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <AssemblyTitle>Fixture Updater</AssemblyTitle>
    <Company>dnSpy.Mcp tests</Company>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="payload.bin" Condition="'$(PayloadPath)' != ''" />
  </ItemGroup>
</Project>
